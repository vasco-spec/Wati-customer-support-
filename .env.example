# Required: REST API endpoint shown in Wati under API → API Docs (host only, no tenant ID).
WATI_API_HOST=https://live-mt-server.wati.io
# Or instead of WATI_API_HOST: global | eu | ksa
# WATI_REGION=global

# Required: API token from Wati (API → API Tokens). Never commit the real value.
WATI_API_TOKEN=

# Optional guardrails / behaviour
WATI_READ_ONLY=false            # true = only read tools are exposed
WATI_REQUIRE_CONFIRM=true       # true = sends return a preview until called with confirm: true
WATI_REPLY_SIGNATURE=           # e.g. "\n— Support team" appended to free-form replies
WATI_CANNED_REPLIES_FILE=       # path to a JSON file like examples/canned-replies.json
WATI_DEFAULT_CHANNEL=           # channel name/number for templates (default channel when empty)
WATI_TIMEOUT_MS=30000
